{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "lib": ["ES2022"],
    // "types": ["node"],  <-- CANCELLA QUESTA RIGA o commentala
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false // Meglio false se hai file JS misti per evitare errori banali
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}