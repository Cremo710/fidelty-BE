# ==================== DATABASE ====================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/loyalty_bar

# ==================== JWT AUTHENTICATION ====================
# Genera una chiave segreta forte (min 32 caratteri)
# Comando per generare: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRY=7d

# ==================== SERVER ====================
# Server port and host configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ==================== CORS ====================
# Comma-separated list of allowed origins
# CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# ==================== EXTERNAL SERVICES ====================
# Taggun API per receipt processing
TAGGUN_API_KEY=your-taggun-api-key-here

# ==================== EMAIL / SMTP ====================
# SMTP per invio notifiche esito richieste bar
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@fidelty.app
EMAIL_FROM_NAME=Fidelty
SMTP_REQUIRE_TLS=false
SMTP_TLS_SERVERNAME=smtp.your-provider.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# ==================== NOTES ====================
# - NODE_ENV: development | production | test
# - JWT_EXPIRY: formato duration (1d, 7d, 24h, 3600s, etc.)
# - Assicurati di cambiare JWT_SECRET in produzione!
# - Utilizza environment manager come Render, Heroku per le variabili in produzione
# - Se SMTP_* / EMAIL_FROM non sono configurate, le email non verranno inviate
# - Porta 465 => SMTP_SECURE=true
# - Porta 587 => SMTP_SECURE=false e opzionalmente SMTP_REQUIRE_TLS=true
